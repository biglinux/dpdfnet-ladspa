# Maintainer: Bruno Goncalves <bigbruno@gmail.com>

# Split package: one LADSPA shared object per upstream DPDFNet model.
# The Rust crate (`../`) builds one .so per `DPDFNET_MODEL` invocation;
# each package_*() function installs only its model's shared object so
# users can pick the trade-off they want without dragging the others
# into the system.

pkgbase='dpdfnet-ladspa'
pkgname=(
	'dpdfnet-ladspa-baseline'
	'dpdfnet-ladspa-dpdfnet2'
	'dpdfnet-ladspa-dpdfnet4'
	'dpdfnet-ladspa-dpdfnet8'
	'dpdfnet-ladspa-dpdfnet2-48khz-hr'
	'dpdfnet-ladspa-dpdfnet8-48khz-hr'
	'dpdfnet-ladspa-baseline-sb'
	'dpdfnet-ladspa-dpdfnet2-sb'
	'dpdfnet-ladspa-dpdfnet4-sb'
	'dpdfnet-ladspa-dpdfnet8-sb'
)
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64')
url='https://github.com/ceva-ip/DPDFNet'
# The shipped .so is our MIT plugin code with upstream's Apache-2.0 model
# embedded in it, so both apply. Upstream (ceva-ip/DPDFNet) ships LICENSE as
# Apache-2.0 covering both its source and the published ONNX weights on HF.
# Citation: Rika, Sapir, Gus (2025) "DPDFNet: Boosting DeepFilterNet2
# via Dual-Path RNN".
license=('MIT' 'Apache-2.0')
makedepends=(
	'cargo'
	'rust'
	'openvino'
	'python'
	'python-numpy'
	'python-onnx'
	'python-openvino'
	'python-typing_extensions'
	'git'
)
options=('!lto')

# Every split ships the same shared object, so they share one dependency
# list. The crate builds with the openvino crate's `runtime-linking`
# feature, so the .so carries no versioned DT_NEEDED and an `openvino`
# update cannot leave it present-but-unloadable again — which is what
# 2026.1→2026.2 and 2026.2→2026.3 each did, crashing the
# bigaudioimprove mic unit both times. A plain dependency is now enough.
_split_depends=('gcc-libs' 'glibc' 'openvino')

# Upstream weights live on Hugging Face. The `dpdfnet` Python package
# wraps a download_model() helper, but plain HTTPS pulls keep the
# build dependency surface small (no `python-filelock`, no Hugging Face
# CLI) and let `makepkg` cache the artifacts the same way it caches
# any other tarball.
# Pinned to a commit, not to `main`: a branch makes the download
# unreproducible and the checksums below meaningless. Bump both together,
# taking the new sums from Hugging Face's `x-linked-etag` header, which is
# the file's sha256 — no need to download to re-pin. That header and the
# download share an origin, so it is a convenience, not a second opinion;
# the copies already in the build cache are what corroborated these.
_hf_rev='dd6818d00f50c836fed43a6243ebe49116de5964'
_hf_base="https://huggingface.co/Ceva-IP/DPDFNet/resolve/${_hf_rev}/onnx"

# Source array order MUST match _models below — the build loop indexes
# both arrays positionally.
_models=(
	'baseline'
	'dpdfnet2'
	'dpdfnet4'
	'dpdfnet8'
	'dpdfnet2_48khz_hr'
	'dpdfnet8_48khz_hr'
)

# Split-band variants. They reuse the 16 kHz models' IR, so they need no ONNX
# of their own and no prepare() step — only a build(), after the base models
# above have populated `model/<name>/`. Kept out of `_models` because that
# array is index-aligned with source=/sha256sums=.
_split_band=(
	'baseline_sb'
	'dpdfnet2_sb'
	'dpdfnet4_sb'
	'dpdfnet8_sb'
)

source=(
	# Repo itself. Build runners (BigLinux build-package, makechrootpkg)
	# only copy PKGBUILD into the chroot, so the crate sources must
	# come in via source=. For local dev (`makepkg` inside `pkgbuild/`),
	# this still clones a fresh copy into ${srcdir} — harmless.
	"${pkgbase}::git+https://github.com/biglinux/dpdfnet-ladspa.git"
	"baseline.onnx::${_hf_base}/baseline.onnx"
	"dpdfnet2.onnx::${_hf_base}/dpdfnet2.onnx"
	"dpdfnet4.onnx::${_hf_base}/dpdfnet4.onnx"
	"dpdfnet8.onnx::${_hf_base}/dpdfnet8.onnx"
	"dpdfnet2_48khz_hr.onnx::${_hf_base}/dpdfnet2_48khz_hr.onnx"
	"dpdfnet8_48khz_hr.onnx::${_hf_base}/dpdfnet8_48khz_hr.onnx"
	# Apache-2.0 §4(a) requires distributing the LICENSE alongside any
	# binary derivative. Pull the upstream copy so each split package
	# can install it under /usr/share/licenses/<pkg>/.
	'LICENSE-DPDFNet::https://raw.githubusercontent.com/ceva-ip/DPDFNet/main/LICENSE'
)

# `SKIP` only for the git checkout, where makepkg has no stable object to
# hash. Every downloaded file is pinned: the models by the `_hf_rev` commit
# above, the licence by content.
sha256sums=(
	'SKIP'
	'371d26182aff0e1e0d31354e24c81f79cd57458f5a7dd003fc10a7ebf64255e0'
	'4f0ee28935b4a32abecc717d745416976565834d839601acf43031094b4dc94c'
	'42a386d3601922f474c4309927e1f471cce422e9bd8e3fd3967bb943bac36c01'
	'899d4f23f3ff86edbffa8c537e4bcbdc49da1b4e84e0ef390611e0604a3b26cb'
	'7f0575a5cec0ba4ffd8f8bd657e06d007e4ccdd955d76faab922b9d3291dc14b'
	'7b3afbb260a08fe9af3d16e3bda992971be1e7e951d1dee7c2d235f5c43f5631'
	'c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4'
)

prepare() {
	# The repo is cloned by makepkg into ${srcdir}/${pkgbase}. The
	# patched ladspa crate is vendored under `vendor/ladspa-patched/`,
	# referenced by [patch.crates-io] in Cargo.toml — no external
	# sibling checkout required.
	cd "${srcdir}/${pkgbase}"
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"

	# Convert each ONNX into OpenVINO IR + extract init_state. The
	# Rust build script reads `model/<name>/{model.xml,model.bin,init_state.bin}`
	# at compile time, so this step must succeed for every model that
	# any of the split packages will install.
	for model in "${_models[@]}"; do
		msg "Preparing ${model}"
		python scripts/prepare_model.py \
			--model "${model}" \
			--src-onnx "${srcdir}/${model}.onnx"
	done
}

build() {
	cd "${srcdir}/${pkgbase}"
	export RUSTUP_TOOLCHAIN=stable
	CARGO_BUILD_JOBS=$(nproc)
	export CARGO_BUILD_JOBS

	# One cargo invocation per model. We isolate target/ per model so
	# build.rs's generated `model_const.rs` from one model never gets
	# served to another (incremental builds key on env var changes via
	# `cargo:rerun-if-env-changed=DPDFNET_MODEL`, but separate target
	# trees make the per-model artifact location unambiguous for the
	# package_*() install steps below).
	for model in "${_models[@]}" "${_split_band[@]}"; do
		msg "Building libdpdfnet_${model}_ladspa.so"
		DPDFNET_MODEL="${model}" \
			CARGO_TARGET_DIR="target-${model}" \
			cargo build --release --frozen
	done
}

_install_model() {
	# $1: upstream model name (e.g. baseline, dpdfnet2_48khz_hr)
	# $2: split package name (used for /usr/share/licenses path)
	local model="$1" pkg="$2"
	cd "${srcdir}/${pkgbase}"

	install -Dm755 "target-${model}/release/libdpdfnet_ladspa.so" \
		"${pkgdir}/usr/lib/ladspa/libdpdfnet_${model}_ladspa.so"

	# Each split package ships its own Apache-2.0 license copy fetched
	# from the upstream ceva-ip/DPDFNet repository (see source= array).
	# Apache-2.0 §4(a) requires the recipient receive the LICENSE with
	# every binary distribution.
	install -Dm644 "${srcdir}/LICENSE-DPDFNet" \
		"${pkgdir}/usr/share/licenses/${pkg}/LICENSE"

	# §4(b) requires modified files to carry a prominent notice saying so.
	# We do not ship upstream's ONNX: `scripts/prepare_model.py` converts it
	# to OpenVINO IR, which the plugin embeds. Say that next to the licence
	# rather than only in a commit message.
	install -Dm644 /dev/stdin \
		"${pkgdir}/usr/share/licenses/${pkg}/NOTICE" <<-NOTICE
			This package contains a modified form of the DPDFNet model
			"${model}" from https://github.com/ceva-ip/DPDFNet, licensed
			under Apache-2.0.

			Modification: the upstream ONNX weights (Hugging Face revision
			${_hf_rev}) were converted to OpenVINO IR by the project's
			scripts/prepare_model.py, and the resulting model.xml/model.bin
			are embedded in the shipped LADSPA shared object. The network
			itself is unchanged.
		NOTICE
}

package_dpdfnet-ladspa-baseline() {
	pkgdesc='DPDFNet 16 kHz baseline LADSPA plugin (fastest, 0-8 kHz band)'
	depends=("${_split_depends[@]}")
	_install_model baseline "${pkgname}"
}

package_dpdfnet-ladspa-dpdfnet2() {
	pkgdesc='DPDFNet-2 16 kHz LADSPA plugin (balanced quality/speed, upstream default)'
	depends=("${_split_depends[@]}")
	_install_model dpdfnet2 "${pkgname}"
}

package_dpdfnet-ladspa-dpdfnet4() {
	pkgdesc='DPDFNet-4 16 kHz LADSPA plugin (higher quality, deeper DPRNN stack)'
	depends=("${_split_depends[@]}")
	_install_model dpdfnet4 "${pkgname}"
}

package_dpdfnet-ladspa-dpdfnet8() {
	pkgdesc='DPDFNet-8 16 kHz LADSPA plugin (highest quality 16 kHz variant)'
	depends=("${_split_depends[@]}")
	_install_model dpdfnet8 "${pkgname}"
}

package_dpdfnet-ladspa-dpdfnet2-48khz-hr() {
	pkgdesc='DPDFNet-2 48 kHz hi-res LADSPA plugin (full-band, balanced)'
	depends=("${_split_depends[@]}")
	_install_model dpdfnet2_48khz_hr "${pkgname}"
}

package_dpdfnet-ladspa-dpdfnet8-48khz-hr() {
	pkgdesc='DPDFNet-8 48 kHz hi-res LADSPA plugin (full-band, highest quality)'
	depends=("${_split_depends[@]}")
	_install_model dpdfnet8_48khz_hr "${pkgname}"
}

# Split-band variants: the 16 kHz networks run at 48 kHz with the band above
# 8 kHz reconstructed, so they are full-band and need no resampler in the graph.
package_dpdfnet-ladspa-baseline-sb() {
	pkgdesc='DPDFNet baseline split-band LADSPA plugin (full-band, lowest compute)'
	depends=("${_split_depends[@]}")
	_install_model baseline_sb "${pkgname}"
}

package_dpdfnet-ladspa-dpdfnet2-sb() {
	pkgdesc='DPDFNet-2 split-band LADSPA plugin (full-band, balanced, no resampler)'
	depends=("${_split_depends[@]}")
	_install_model dpdfnet2_sb "${pkgname}"
}

package_dpdfnet-ladspa-dpdfnet4-sb() {
	pkgdesc='DPDFNet-4 split-band LADSPA plugin (full-band, higher quality)'
	depends=("${_split_depends[@]}")
	_install_model dpdfnet4_sb "${pkgname}"
}

package_dpdfnet-ladspa-dpdfnet8-sb() {
	pkgdesc='DPDFNet-8 split-band LADSPA plugin (full-band, highest quality)'
	depends=("${_split_depends[@]}")
	_install_model dpdfnet8_sb "${pkgname}"
}
